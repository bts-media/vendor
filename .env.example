# .env ni shu fayldan nusxalab yarating: cp .env.example .env
# Faqat VITE_ prefiksli o'zgaruvchilar klientga yetadi.
# Hech qachon maxfiy kalitni VITE_ ga qo'ymang — u bundle ichida ochiq ko'rinadi.

VITE_APP_MODE=development
VITE_API_DEVELOPMENT_URL=https://bts-api.ebilim-gate.appx.uz
VITE_API_PRODUCTION_URL=https://bts-api.ebilim-gate.appx.uz
